# Local Development Database Configuration (SQLite)
DB_DIALECT=sqlite
DB_NAME=koperasi
DB_USER=root
DB_PASSWORD=
DB_STORAGE=./database/local-dev.sqlite

# Sequelize connection options
DB_POOL_MAX=5
DB_POOL_MIN=1

# Security
NODE_TLS_REJECT_UNAUTHORIZED=0

# Server configuration (override from package.json defaults)
HTTPS_PORT=3445
HTTP_PORT=3000

# Set NODE_ENV to development to avoid production-only errors
NODE_ENV=development
