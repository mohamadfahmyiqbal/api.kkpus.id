{
  "development": {
    "username": "process.env.DB_USER",
    "password": "process.env.DB_PASSWORD",
    "database": "process.env.DB_NAME",
    "host": "process.env.DB_HOST",
    "dialect": "mysql",
    "pool": {
      "max": 20,
      "min": 2,
      "acquire": 120000,
      "idle": 30000
    },
    "dialectOptions": {
      "dateStrings": true,
      "typeCast": true,
      "timezone": "+07:00",
      "connectTimeout": 60000
    },
    "timezone": "+07:00",
    "logging": false
  },
  "production": {
    "username": "process.env.DB_USER",
    "password": "process.env.DB_PASSWORD",
    "database": "process.env.DB_NAME",
    "host": "process.env.DB_HOST",
    "dialect": "mysql",
    "pool": {
      "max": 20,
      "min": 2,
      "acquire": 120000,
      "idle": 30000
    },
    "dialectOptions": {
      "dateStrings": true,
      "typeCast": true,
      "timezone": "+07:00",
      "connectTimeout": 60000
    },
    "timezone": "+07:00",
    "logging": false
  }
}
