{
  "name": "be",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "kill-port": "npx kill-port 3000",
    "dev": "nodemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:pure": "vitest run test/configControllers.test.js test/savingsDeduplication.test.js"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "env": {
      "es2022": true,
      "node": true
    },
    "overrides": [
      {
        "files": [
          "*.cjs",
          "**/*.cjs",
          "npm_audit.js",
          "npm_lint.js",
          "test-database.js",
          "test-db-vps.js",
          "services/ratGenerator.js"
        ],
        "env": {
          "node": true,
          "commonjs": true
        }
      }
    ],
    "rules": {
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ]
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^13.6.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.4.3",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.0",
    "mysql2": "^3.14.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.1.10",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "unique-names-generator": "^4.7.1",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1"
  }
}
