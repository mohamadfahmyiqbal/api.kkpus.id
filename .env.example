# Environment Variables - api.kkpus.id

# Database Configuration
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=kkpusid
DB_NAME=koperasi
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=20
DB_POOL_MIN=2

# Security
NODE_TLS_REJECT_UNAUTHORIZED=0

# Server configuration
HTTPS_PORT=3445
HTTP_PORT=3000

# SSL configuration
SSL_KEY_PATH=config/certs/production/kkpusid.key
SSL_CERT_PATH=config/certs/production/kkpus_id.crt
SSL_CA_PATH=config/certs/production/ca.crt

# Set NODE_ENV to development to avoid production-only errors
NODE_ENV=development

# Security - must be set via secrets manager in production
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS