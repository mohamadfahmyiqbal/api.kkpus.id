# Environment Variables - api.kkpus.id

# Database Configuration
DB_DIALECT=mysql
DB_HOST=202.52.147.193
DB_PORT=3306
DB_USER=admin
DB_NAME=koperasi
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=20
DB_POOL_MIN=2

# Security
NODE_TLS_REJECT_UNAUTHORIZED=0

# Server configuration
HTTPS_PORT=3445
HTTP_PORT=3000

# SSL configuration
SSL_KEY_PATH=config/certs/production/kkpusid.key
SSL_CERT_PATH=config/certs/production/kkpus_id.crt
SSL_CA_PATH=config/certs/production/ca.crt

# Set NODE_ENV to development to avoid production-only errors
NODE_ENV=development

# VAPID Configuration for Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@kkpus.id

# Security - must be set via secrets manager in production
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS