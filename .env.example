# Environment Variables Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
NODE_ENV=development
HTTP_PORT=3000
HTTPS_PORT=3443

# Database Configuration
DB_HOST=202.52.147.193
DB_NAME=koperasi
DB_USER=admin
DB_PASSWORD=your_database_password_here

# Security
JWT_SECRET=your_very_strong_jwt_secret_key_here_minimum_32_characters
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# SSL Configuration (for HTTPS)
SSL_KEY_PATH=./path/to/ssl/private.key
SSL_CERT_PATH=./path/to/ssl/certificate.crt

# Email Configuration
EMAIL_PROVIDER=console  # console, sendgrid, ses
SENDGRID_API_KEY=your_sendgrid_api_key_here
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# SMS Configuration
SMS_PROVIDER=console  # console, twilio, wa
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Configuration (if using WA provider)
WA_API_KEY=your_whatsapp_api_key_here
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Push Notification Configuration
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@yourdomain.com

# Logging
LOG_LEVEL=info  # error, warn, info, debug
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_MAX=3
