# .env.example - Konfigurasi Template Lingkungan KKPUS API
# Salin ke .env dan isi dengan secret aktual

NODE_ENV=development
HTTP_PORT=3000
HTTPS_PORT=3445

# Database Configuration
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=koperasi
DB_USER=kkpusid
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# Security & Secrets (Ganti minimal 32 karakter acak)
JWT_SECRET=YOUR_MINIMUM_32_CHAR_JWT_SECRET_RANDOM_STRING
CSRF_SECRET=YOUR_MINIMUM_32_CHAR_CSRF_SECRET_STRING

# SSL/TLS Configuration (Opsional di balik Nginx reverse-proxy)
SSL_KEY_PATH=/etc/letsencrypt/live/api.kkpus.id/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/api.kkpus.id/fullchain.pem
SSL_CA_PATH=

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=15
OTP_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=5

# Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
BYPASS_WEBHOOK_IP_WHITELIST=false

# Monitoring & Alerting
ALERT_WEBHOOK_URL=https://monitoring.example.com/alerts/api-memory
